# ============================================================================================
# DOINg.AI Factory — backend deployment settings
# Copy to backend/.env (never committed) and adjust. A real environment variable overrides
# the value written here.
#
# Nothing here is required. The Factory starts clean: with this file empty the whole UI
# loads, and only the feature whose dependency is missing fails — with a message that says
# where to fix it (e.g. "No LLM configured — open Settings › AI Model").
# The AI model, connectors, engine and scheduler are configured at runtime in the UI and
# stored in the database, not here.
# ============================================================================================

# --- Server -----------------------------------------------------------------------------------
# Loopback by default. Set 0.0.0.0 only to expose the Factory on your network.
FACTORY_HOST=127.0.0.1
# API port (the Vite dev server runs the UI on 3070 and proxies /api and /mcp here).
FACTORY_PORT=3071

# --- Storage (relative paths resolve against backend/) ----------------------------------------
FACTORY_DATA_DIR=data
FACTORY_DB_PATH=data/factory.db
# Built UI served on the same origin as the API. Empty = auto-detect ../frontend/dist.
FACTORY_STATIC_DIR=

# --- Background jobs ---------------------------------------------------------------------------
# Scheduler loop (watchers, wait_for polling, SLA checks) + boot-time connector checks.
# Set false for one-off scripts that import the app without wanting it to poll real systems.
FACTORY_BACKGROUND_JOBS=true

# --- First-boot AI model (optional) -------------------------------------------------------------
# Pre-fills Settings › AI Model on the very first boot only, so a scripted install comes up
# connected. Ignored once the settings were saved in the UI (the UI is the source of truth).
# Provider: "ollama" (native API, base URL WITHOUT /v1) or "openai" (any OpenAI-compatible
# server: LM Studio, vLLM, llama.cpp…, base URL WITH /v1).
# Example for a local Ollama:
#   FACTORY_LLM_PROVIDER=ollama
#   FACTORY_LLM_BASE_URL=http://127.0.0.1:11434
#   FACTORY_LLM_MODEL=qwen3.5:4b
FACTORY_LLM_PROVIDER=
FACTORY_LLM_BASE_URL=
FACTORY_LLM_MODEL=
FACTORY_LLM_API_KEY=
